# ---------------------------------------------------------------------------
# Editorial Alcedo — variables de entorno
#
# Copia este fichero a `.env.local` y rellena lo que necesites.
# `.env.local` NUNCA se sube al repositorio.
#
# El sitio ARRANCA SIN NINGUNA de estas variables: entra en «modo local», guarda
# en memoria y escribe los correos por consola. Sirve para desarrollar y para
# probar la compra entera sin cuentas.
# ---------------------------------------------------------------------------

# === SITIO =================================================================
# URL canónica, sin barra final. Se usa en metadatos, Open Graph, sitemap,
# canónicas y en los enlaces de los correos.
# En local, déjala así. En Vercel, mientras no haya dominio propio, el sitio usa
# solo la URL del proyecto, así que puedes no definirla.
NEXT_PUBLIC_URL_SITIO=http://localhost:3000


# === SUPABASE ==============================================================
# Panel de Supabase → Project Settings → API.
#
# Sin estas variables: los pedidos y las altas se guardan en memoria (se pierden
# al reiniciar), no hay ficheros que descargar y el área de cliente avisa de que
# está en modo local.
#
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# ⚠️ La clave de servicio se salta TODAS las políticas de seguridad. Va solo en
# el servidor: no la prefijes nunca con NEXT_PUBLIC_ ni la pegues en el navegador.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Antes de usarla, aplica el esquema: SQL Editor → pega
# supabase/migraciones/0001_esquema.sql → Run.


# === RESEND ================================================================
# Sin estas variables, los correos se escriben en la consola del servidor con su
# contenido completo, lo que va bien para desarrollar.
#
# RESEND_API_KEY=
# Remitente verificado en Resend, con tu dominio.
# EMAIL_REMITENTE="Editorial Alcedo <hola@ejemplo.com>"
# Buzón interno para avisos (opcional).
# EMAIL_INTERNO=


# === PASARELA DE PAGO ======================================================
# `simulado` permite construir y probar la tienda entera sin credenciales, que es
# lo que hace falta mientras Paddle revisa la cuenta. `paddle` cobra de verdad.
PROVEEDOR_PAGO=simulado

# Paddle Billing → Developer Tools. Obligatorias si PROVEEDOR_PAGO=paddle.
# PADDLE_API_KEY=
# PADDLE_SECRETO_WEBHOOK=
# `sandbox` mientras se prueba, `production` al ir en vivo.
# PADDLE_ENTORNO=sandbox
#
# Además, cada producto necesita su id de precio de Paddle en el campo
# `idProveedorPago` de su fichero en content/productos/.


# ---------------------------------------------------------------------------
# Nota: no hay ningún secreto para firmar los enlaces de descarga.
# Los tokens son aleatorios y se guardan en base de datos, lo que permite
# revocarlos y contar las descargas. Un token firmado no se puede revocar.
# ---------------------------------------------------------------------------
