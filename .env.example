# ---------------------------------------------------------------------------
# Editorial Alcedo — variables de entorno
# Copia este fichero a `.env.local` y rellena lo que necesites.
# `.env.local` NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# === SITIO (Fase 1) ========================================================
# URL canónica del sitio, sin barra final. Se usa en metadatos, Open Graph,
# sitemap.xml y canónicas. En local déjalo en http://localhost:3000.
# En Vercel, mientras no haya dominio propio, usa la URL del proyecto
# (p. ej. https://alcedo-web.vercel.app) y cámbiala el día que compres el dominio.
NEXT_PUBLIC_URL_SITIO=http://localhost:3000


# === SUPABASE (Fase 3) =====================================================
# Panel de Supabase → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO en el servidor. No la prefijes con NEXT_PUBLIC_,
# porque eso la publicaría en el bundle del navegador.
# SUPABASE_SERVICE_ROLE_KEY=


# === RESEND (Fase 3) =======================================================
# RESEND_API_KEY=
# Remitente verificado en Resend, con el dominio del sitio.
# EMAIL_REMITENTE="Editorial Alcedo <hola@ejemplo.com>"
# Buzón que recibe los avisos internos (formulario de contacto, errores de pago).
# EMAIL_INTERNO=


# === PASARELA DE PAGO (Fase 3) =============================================
# Proveedor activo: `paddle` o `simulado`.
# `simulado` permite construir y probar la tienda entera sin credenciales reales,
# que es lo que necesitamos mientras Paddle revisa la cuenta.
PROVEEDOR_PAGO=simulado

# Paddle Billing → Developer Tools
# PADDLE_API_KEY=
# PADDLE_SECRETO_WEBHOOK=
# `sandbox` mientras se prueba, `production` al ir en vivo.
# PADDLE_ENTORNO=sandbox
# NEXT_PUBLIC_PADDLE_TOKEN_CLIENTE=


# === SEGURIDAD DE DESCARGAS (Fase 3) =======================================
# Secreto para firmar los tokens de descarga. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETO_TOKENS_DESCARGA=
